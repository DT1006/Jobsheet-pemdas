<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hubungi Kami - Nama Lengkap Anda</title>
</head>

<body>
    <header>
        <h1>Hubungi Saya</h1>
        <nav>
            <a href="index.html">Beranda</a> |
            <a href="kontak.html">Kontak</a>
        </nav>
    </header>

    <main>
        <h2>Formulir Aspirasi</h2>
        <form action="#" method="POST">
            <p>
                <label for="nama">Nama:</label><br>
                <input type="text" id="nama" name="nama" placeholder="Masukkan nama Anda..." required>
            </p>
            <p>
                <label for="email">Email:</label><br>
                <input type="email" id="email" name="email" placeholder="contoh: nama@email.com" required>
            </p>
            <p>
                <label for="pesan">Pesan/Saran:</label><br>
                <textarea id="pesan" name="pesan" rows="5" cols="40" placeholder="Tulis pesan atau saran Anda..."
                    required></textarea>
            </p>
            <p>
                <button type="submit">Kirim</button>
            </p>
        </form>
    </main>

    <footer>
        <p>&copy; 2026 Dionisius Tobias. Hak cipta dilindungi.</p>
    </footer>
</body>

</html>